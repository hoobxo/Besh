{
  "name": "besh",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run check:types && npm run check:web && npm run check:bundle",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:bundle": "wrangler deploy --dry-run --outdir .wrangler/build",
    "dev": "wrangler dev",
    "check:web": "npm run build --workspace apps/web"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.0.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.1"
  }
}
